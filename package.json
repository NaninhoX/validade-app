{
  "name": "controle-validade",
  "version": "0.1.0",
  "description": "Controle de validade: dashboard, mapa de calor e coletor (PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lan": "node server.js --lan",
    "import": "node --env-file-if-exists=.env.local scripts/import.js",
    "usuario": "node --env-file-if-exists=.env.local scripts/usuario.js",
    "test": "node --test test/*.test.js",
    "inverter-lados": "node --env-file-if-exists=.env.local scripts/inverter-lados.js",
    "baixar-vendidos": "node --env-file-if-exists=.env.local scripts/baixar-vendidos.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@zxing/library": "^0.23.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.13"
  }
}
